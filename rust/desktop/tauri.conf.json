{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQLTools",
  "version": "0.1.1",
  "identifier": "com.sqltools.rust",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "npm --prefix web run build"
  },
  "app": {
    "windows": [
      {
        "title": "SQLTools",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/silviosotelo/sqltools/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2QUI2Q0QxOUFCOUVGNDUKUldSRjc3bWEwV3lyNW1uTGVKZWtSdUlGTSszaG1XbVBEQmYrQUlGdGhIVXYyNHI5dUVQTFZ3U0cK"
    }
  }
}
